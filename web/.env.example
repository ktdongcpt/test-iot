# MQTT Broker Settings
NEXT_PUBLIC_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
NEXT_PUBLIC_MQTT_TOPIC_DATA=3FAMIOT/HMI_PUB
NEXT_PUBLIC_MQTT_TOPIC_CMD=3FAMIOT/HMI_SUB
NEXT_PUBLIC_MQTT_TOPIC_TIME=3FAMIOT/TIME
NEXT_PUBLIC_MQTT_TOPIC_ALARM=3FAMIOT/ALARM

# Supabase Settings (Tùy chọn: Nhập URL và Anon Key từ dự án Supabase của bạn)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
